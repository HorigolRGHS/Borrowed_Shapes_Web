    {
      "name": "Admin Writes",
      "description": "Admin-only mutations. Requires {{accessToken}} for an ADMIN role user.",
      "item": [
        {
          "name": "Create wiki",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "if (json.success) {\r",
                  "  pm.environment.set(\"wikiId\", json.data.id);\r",
                  "  pm.environment.set(\"wikiSlug\", json.data.slug);\r",
                  "  pm.environment.set(\"revisionId\", json.data.latestRevision.id);\r",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"dragon-knight\",\n  \"slug_vi\": \"hiep-si-rong\",\n  \"title\": \"Dragon Knight\",\n  \"title_vi\": \"Hiệp sĩ rồng\",\n  \"content\": \"# Hello\\n\\nThis is the dragon knight.\",\n  \"content_vi\": \"# Xin chào\\n\\nĐây là hiệp sĩ rồng.\",\n  \"summary\": \"Class summary\",\n  \"summary_vi\": \"Tóm tắt class\",\n  \"isPublished\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki"]
            }
          },
          "response": []
        },
        {
          "name": "Update wiki",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "if (json.success) {\r",
                  "  pm.environment.set(\"revisionId\", json.data.latestRevision.id);\r",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"dragon-knight\",\n  \"slug_vi\": \"hiep-si-rong\",\n  \"title\": \"Dragon Knight v2\",\n  \"title_vi\": \"Hiệp sĩ rồng v2\",\n  \"content\": \"# Updated\\n\\nNew content.\",\n  \"content_vi\": \"# Cập nhật\\n\\nNội dung mới.\",\n  \"expectedLatestRevisionId\": \"{{revisionId}}\",\n  \"forceOverwrite\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete wiki",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Rollback to revision",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "if (json.success) {\r",
