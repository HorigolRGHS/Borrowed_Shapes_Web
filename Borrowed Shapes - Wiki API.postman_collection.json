        {
          "name": "409 - Slug taken (create twice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 409 wiki.slug_taken. Run the regular Create wiki request first to seed slug 'dragon-knight', then send this request to attempt the same slug again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"dragon-knight\",\n  \"slug_vi\": \"hiep-si-rong\",\n  \"title\": \"Dragon Knight (dup)\",\n  \"title_vi\": \"Hiệp sĩ rồng (trùng)\",\n  \"content\": \"# dup\",\n  \"content_vi\": \"# trùng\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki"]
            }
          },
          "response": []
        },
        {
          "name": "409 - Conflict revision",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 409 wiki.conflict_revision. Setup: capture an old revision id (e.g. from a fresh Create) into {{revisionId}}, run Update once so the latest revision moves forward, then send this request reusing the stale {{revisionId}} so expectedLatestRevisionId no longer matches the latest.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"dragon-knight\",\n  \"slug_vi\": \"hiep-si-rong\",\n  \"title\": \"Dragon Knight stale\",\n  \"title_vi\": \"Hiệp sĩ rồng (cũ)\",\n  \"content\": \"# stale\",\n  \"content_vi\": \"# cũ\",\n  \"expectedLatestRevisionId\": \"{{revisionId}}\",\n  \"forceOverwrite\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}"]
            }
          },
          "response": []
        },
        {
          "name": "413 - Upload too large",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 413 wiki.upload_too_large. Manual test: attach an image file > 5MB to the `file` form field. Multer's fileSize limit (UPLOAD_MAX_SIZE = 5 MiB) plus the explicit size check in the controller should produce a 413.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Manually attach a file larger than 5MB"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "415 - Upload invalid type (SVG)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 415 wiki.upload_invalid_type. Manual test: attach an SVG (or any non-jpeg/png/webp/gif) file to the `file` form field. ALLOWED_UPLOAD_MIMES does not include image/svg+xml, so the upload validator should reject it.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
