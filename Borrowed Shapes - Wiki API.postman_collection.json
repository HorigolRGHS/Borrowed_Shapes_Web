        {
          "name": "400 - Cannot publish empty",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 400 wiki.cannot_publish_empty. Setup: create a wiki with empty content/content_vi (or update it to be empty) and capture its id into {{wikiId}}, then call this endpoint.",
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}", "publish"]
            }
          },
          "response": []
