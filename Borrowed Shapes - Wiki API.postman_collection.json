    {
      "name": "Upload",
      "description": "Admin-only image upload. Multipart form-data; field name is `file`. Allowed mime types: image/jpeg, image/png, image/webp, image/gif. Max size 5MB.",
      "item": [
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick a jpeg/png/webp/gif file <= 5MB"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "upload"]
