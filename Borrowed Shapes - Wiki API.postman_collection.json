{
  "info": {
    "_postman_id": "c1d2e3f4-5a6b-7c8d-9e0f-112233445566",
    "name": "Borrowed Shapes - Wiki API",
    "description": "CRUD, search, history, rollback, publish/unpublish, image upload for the wiki module. Run after the Auth collection's Login to populate {{accessToken}}.\n\nFlow: Login (from Auth collection) -> Create -> Get by slug -> Update -> History -> Rollback -> Delete.\n\nVariables used:\n- {{baseUrl}} (shared with Auth collection, e.g. http://localhost:3001)\n- {{accessToken}} (set by Auth collection's Login)\n- {{wikiId}} (set by Create wiki / List published)\n- {{wikiSlug}} (set by Create wiki)\n- {{revisionId}} (set by Create wiki / Get by slug / Update)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public Reads",
      "item": [
        {
          "name": "List published",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "if (json.success && json.data && json.data.items && json.data.items.length > 0) {\r",
                  "  pm.environment.set(\"wikiId\", json.data.items[0].id);\r",
                  "  pm.environment.set(\"wikiSlug\", json.data.items[0].slug);\r",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wiki?page=1&limit=20&q=&sort=createdAt&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "q", "value": "" },
                { "key": "sort", "value": "createdAt" },
                { "key": "order", "value": "desc" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search wiki",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wiki/search?q=dragon&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "search"],
              "query": [
                { "key": "q", "value": "dragon" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get by slug",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "if (json.success && json.data && json.data.latestRevision) {\r",
                  "  pm.environment.set(\"revisionId\", json.data.latestRevision.id);\r",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wiki/slug/{{wikiSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "slug", "{{wikiSlug}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "History",
      "description": "Authenticated reads (USER or ADMIN). Requires {{accessToken}} from the Auth collection's Login.",
      "item": [
        {
          "name": "List revisions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}/history?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get single revision",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}/history/{{revisionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}", "history", "{{revisionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Diff revision vs previous",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}/history/{{revisionId}}/diff",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}", "history", "{{revisionId}}", "diff"]
            }
          },
          "response": []
        }
      ]
    },
