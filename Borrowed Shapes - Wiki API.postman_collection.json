            "url": {
              "raw": "{{baseUrl}}/api/wiki/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "upload"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 401) {\r",
          "    const refreshReq = {\r",
          "        url: pm.environment.get(\"baseUrl\") + \"/api/auth/refresh\",\r",
          "        method: \"POST\",\r",
          "        header: { \"Content-Type\": \"application/json\" },\r",
          "        body: {\r",
          "            mode: \"raw\",\r",
          "            raw: JSON.stringify({\r",
          "                refreshToken: pm.environment.get(\"refreshToken\")\r",
          "            })\r",
          "        }\r",
          "    };\r",
          "\r",
          "    pm.sendRequest(refreshReq, (err, res) => {\r",
          "        if (!err && res.code === 200) {\r",
          "            const json = res.json();\r",
          "            const data = json.data || json;\r",
          "            pm.environment.set(\"accessToken\", data.accessToken);\r",
          "            pm.environment.set(\"refreshToken\", data.refreshToken);\r",
          "            postman.setNextRequest(pm.info.requestName);\r",
          "        }\r",
          "    });\r",
          "}"
        ]
      }
    }
  ],
  "variable": [
