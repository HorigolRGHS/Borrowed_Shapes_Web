          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetRevisionId\": \"<paste a revision id from history>\",\n  \"expectedLatestRevisionId\": \"{{revisionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}/rollback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}", "rollback"]
            }
