    {
      "name": "Abnormal Cases",
      "description": "Negative paths to verify 4xx error handling. Each request includes a description explaining the expected status and message.",
      "item": [
        {
          "name": "401 - History without auth",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Expected: 401 Unauthorized. The history endpoint requires a valid access token; sending no Authorization header should be rejected by the global auth guard.",
            "url": {
              "raw": "{{baseUrl}}/api/wiki/{{wikiId}}/history?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "{{wikiId}}", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "403 - Create with USER role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 403 Forbidden. Manual setup: log in as a USER (not ADMIN) so {{accessToken}} carries the USER role, then run this. The @Roles('ADMIN') guard on the admin controller should reject the request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"forbidden-page\",\n  \"slug_vi\": \"trang-cam\",\n  \"title\": \"Forbidden\",\n  \"title_vi\": \"Cấm\",\n  \"content\": \"# nope\",\n  \"content_vi\": \"# không\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki"]
            }
          },
          "response": []
        },
        {
          "name": "404 - Get by non-existent slug",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Expected: 404 wiki.not_found. The slug 'non-existent-slug' should not match any published page.",
            "url": {
              "raw": "{{baseUrl}}/api/wiki/slug/non-existent-slug",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki", "slug", "non-existent-slug"]
            }
          },
          "response": []
        },
        {
          "name": "400 - Invalid slug format",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 400 wiki.invalid_slug. Slug 'Bad Slug!' fails the [a-z0-9-]+ regex (uppercase, space, exclamation).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"Bad Slug!\",\n  \"slug_vi\": \"slug-vi\",\n  \"title\": \"Bad slug demo\",\n  \"title_vi\": \"Demo slug xấu\",\n  \"content\": \"# x\",\n  \"content_vi\": \"# x\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki"]
            }
          },
          "response": []
        },
        {
          "name": "400 - Reserved slug",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Expected: 400 wiki.reserved_slug. The slug 'admin' is in RESERVED_SLUGS and must be rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"admin\",\n  \"slug_vi\": \"slug-vi\",\n  \"title\": \"Reserved slug demo\",\n  \"title_vi\": \"Demo slug dự trữ\",\n  \"content\": \"# x\",\n  \"content_vi\": \"# x\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wiki",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wiki"]
            }
          },
          "response": []
