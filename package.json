{
  "name": "borrowed-shapes-wiki",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev:clean": "kill-port 3000 3001",
    "dev": "npm run dev:clean && concurrently -k -n web,api \"next dev --turbopack\" \"npm --prefix server run start:dev\"",
    "build": "next build",
    "start": "concurrently -k -n web,api \"next start\" \"npm --prefix server run start:prod\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@ckeditor/ckeditor5-react": "^11.1.2",
    "@hookform/resolvers": "^5.2.2",
    "axios": "^1.16.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.14.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-toastify": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "kill-port": "^2.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
